{
  "name": "naf/database",
  "description": "NAF Database Plugin to work with various storage solutions.",
  "minimum-stability": "stable",
  "license": "MIT",
  "type": "naf-plugin",
  "authors": [
    {
      "name": "Flo Knapp",
      "email": "office@florianknapp.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Naf\\Database\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Fixtures\\": "tests/Fixtures/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "naf/framework": "^0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.1",
    "phpunit/php-code-coverage": "^12.1",
    "naf/cli": "^0.2"
  },
  "scripts": {
    "test": "phpunit --colors=always"
  }
}
